<script>
let currentPage = 1;
let totalPages = 1;
let restaurantToDelete = null;

// Load restaurants table on page load
document.addEventListener('DOMContentLoaded', function() {
    loadRestaurants();
});

// Load restaurants table
function loadRestaurants(page = 1) {
    currentPage = page;
    
    // Show loading state
    const tbody = document.getElementById('restaurants-body');
    tbody.innerHTML = `
        <tr>
            <td colspan="6">
                <div class="loading">
                    <div class="loading-spinner"></div>
                    <p>Loading restaurants...</p>
                </div>
            </td>
        </tr>
    `;
    
    fetch(`/admin/restaurants?page=${page}&limit=10`)
        .then(response => response.json())
        .then(data => {
            tbody.innerHTML = '';
            
            if (data.restaurants.length === 0) {
                tbody.innerHTML = `
                    <tr>
                        <td colspan="6">
                            <div class="empty-state">
                                <h3>No restaurants found</h3>
                                <p>Click "Add New Restaurant" to create your first restaurant.</p>
                                <button class="add-resto-btn" onclick="showAddRestaurantForm()" style="margin-top: 15px;">
                                    <i class="fas fa-plus"></i> Add Restaurant
                                </button>
                            </div>
                        </td>
                    </tr>
                `;
            } else {
                data.restaurants.forEach(restaurant => {
                    const row = document.createElement('tr');
                    row.innerHTML = `
                        <td class="resto-id">${restaurant.restoID}</td>
                        <td class="resto-name">${restaurant.restoName}</td>
                        <td class="resto-desc">${restaurant.restoDesc ? restaurant.restoDesc.substring(0, 100) + (restaurant.restoDesc.length > 100 ? '...' : '') : 'No description'}</td>
                        <td>
                            <span class="rating-badge rating-${restaurant.aveRating}">
                                ${restaurant.aveRating === 'W' ? 'Worth it' : 
                                  restaurant.aveRating === 'L' ? 'Lacking' : 'Moderate'}
                            </span>
                        </td>
                        <td>
                            ${restaurant.image ? 
                                `<img src="${restaurant.image}" alt="${restaurant.restoName}" class="restaurant-image">` : 
                                '<span style="color: #95a5a6; font-size: 14px;">No image</span>'}
                        </td>
                        <td>
                            <div class="action-buttons">
                                <button class="edit-btn" onclick="editRestaurant(${restaurant.restoID})">
                                    <i class="fas fa-edit"></i> Edit
                                </button>
                                <button class="delete-btn" onclick="deleteRestaurant(${restaurant.restoID})">
                                    <i class="fas fa-trash"></i> Delete
                                </button>
                            </div>
                        </td>
                    `;
                    tbody.appendChild(row);
                });
            }
            
            totalPages = data.totalPages;
            updatePagination();
        })
        .catch(error => {
            console.error('Error loading restaurants:', error);
            tbody.innerHTML = `
                <tr>
                    <td colspan="6">
                        <div class="empty-state" style="color: #e74c3c;">
                            <h3>Error loading restaurants</h3>
                            <p>Please try again later.</p>
                            <button class="add-resto-btn" onclick="loadRestaurants()" style="margin-top: 15px; background: #3498db;">
                                <i class="fas fa-redo"></i> Retry
                            </button>
                        </div>
                    </td>
                </tr>
            `;
        });
}

// Update pagination controls
function updatePagination() {
    const pagination = document.getElementById('pagination');
    let html = '';
    
    if (totalPages <= 1) {
        pagination.innerHTML = '';
        return;
    }
    
    if (currentPage > 1) {
        html += `<button class="page-btn" onclick="loadRestaurants(${currentPage - 1})">
                    <i class="fas fa-chevron-left"></i> Previous
                 </button>`;
    }
    
    // Show current page and nearby pages
    const startPage = Math.max(1, currentPage - 2);
    const endPage = Math.min(totalPages, currentPage + 2);
    
    for (let i = startPage; i <= endPage; i++) {
        if (i === currentPage) {
            html += `<span class="current-page">${i}</span>`;
        } else {
            html += `<button class="page-btn" onclick="loadRestaurants(${i})">${i}</button>`;
        }
    }
    
    if (currentPage < totalPages) {
        html += `<button class="page-btn" onclick="loadRestaurants(${currentPage + 1})">
                    Next <i class="fas fa-chevron-right"></i>
                 </button>`;
    }
    
    pagination.innerHTML = html;
}

// Show add restaurant form
function showAddRestaurantForm() {
    document.getElementById('modal-title').textContent = 'Add New Restaurant';
    document.getElementById('restaurant-form').reset();
    document.getElementById('restoID').value = '';
    document.getElementById('image-preview').innerHTML = '';
    document.getElementById('restaurant-modal').style.display = 'flex';
}

// Show edit restaurant form
function editRestaurant(restoID) {
    fetch(`/admin/restaurants/${restoID}`)
        .then(response => response.json())
        .then(restaurant => {
            document.getElementById('modal-title').textContent = 'Edit Restaurant';
            document.getElementById('restoID').value = restaurant.restoID;
            document.getElementById('restoName').value = restaurant.restoName;
            document.getElementById('restoDesc').value = restaurant.restoDesc || '';
            document.getElementById('aveRating').value = restaurant.aveRating || 'M';
            
            // Show current image if exists
            const imagePreview = document.getElementById('image-preview');
            imagePreview.innerHTML = '';
            if (restaurant.image) {
                const img = document.createElement('img');
                img.src = restaurant.image;
                img.alt = restaurant.restoName;
                imagePreview.appendChild(img);
            }
            
            document.getElementById('restaurant-modal').style.display = 'flex';
        })
        .catch(error => {
            console.error('Error loading restaurant:', error);
            alert('Error loading restaurant details. Please try again.');
        });
}

// Handle form submission
document.getElementById('restaurant-form').addEventListener('submit', function(e) {
    e.preventDefault();
    
    const formData = new FormData(this);
    const restoID = document.getElementById('restoID').value;
    const isEdit = restoID !== '';
    
    const url = isEdit ? `/admin/restaurants/${restoID}` : '/admin/restaurants';
    const method = isEdit ? 'PUT' : 'POST';
    
    const submitBtn = this.querySelector('.submit-btn');
    const originalText = submitBtn.innerHTML;
    submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Saving...';
    submitBtn.disabled = true;
    
    fetch(url, {
        method: method,
        body: formData
    })
    .then(response => response.json())
    .then(data => {
        if (data.message) {
            alert(data.message);
            closeModal();
            loadRestaurants(currentPage);
        }
    })
    .catch(error => {
        console.error('Error saving restaurant:', error);
        alert('Error saving restaurant. Please try again.');
    })
    .finally(() => {
        submitBtn.innerHTML = originalText;
        submitBtn.disabled = false;
    });
});

// Show delete confirmation
function deleteRestaurant(restoID) {
    restaurantToDelete = restoID;
    document.getElementById('delete-modal').style.display = 'flex';
}

// Confirm delete
function confirmDelete() {
    if (!restaurantToDelete) return;
    
    const deleteBtn = document.querySelector('.delete-confirm-btn');
    const originalText = deleteBtn.innerHTML;
    deleteBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Deleting...';
    deleteBtn.disabled = true;
    
    fetch(`/admin/restaurants/${restaurantToDelete}`, {
        method: 'DELETE'
    })
    .then(response => response.json())
    .then(data => {
        if (data.message) {
            alert(data.message);
            closeDeleteModal();
            loadRestaurants(currentPage);
        }
    })
    .catch(error => {
        console.error('Error deleting restaurant:', error);
        alert('Error deleting restaurant. Please try again.');
    })
    .finally(() => {
        deleteBtn.innerHTML = originalText;
        deleteBtn.disabled = false;
    });
}

// Close modals
function closeModal() {
    document.getElementById('restaurant-modal').style.display = 'none';
}

function closeDeleteModal() {
    document.getElementById('delete-modal').style.display = 'none';
    restaurantToDelete = null;
}

// Close modal when clicking outside
window.onclick = function(event) {
    const modals = ['restaurant-modal', 'delete-modal'];
    modals.forEach(modalId => {
        const modal = document.getElementById(modalId);
        if (event.target === modal) {
            if (modalId === 'restaurant-modal') closeModal();
            if (modalId === 'delete-modal') closeDeleteModal();
        }
    });
}

// Handle image preview
document.getElementById('image').addEventListener('change', function(e) {
    const file = e.target.files[0];
    const preview = document.getElementById('image-preview');
    
    if (file) {
        if (file.size > 5 * 1024 * 1024) { 
            alert('Image size should be less than 5MB');
            this.value = '';
            preview.innerHTML = '';
            return;
        }
        
        const reader = new FileReader();
        reader.onload = function(e) {
            preview.innerHTML = `<img src="${e.target.result}" alt="Preview">`;
        };
        reader.readAsDataURL(file);
    } else {
        preview.innerHTML = '';
    }
});

// Close modal with Escape key
document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
        closeModal();
        closeDeleteModal();
    }
});


function validateRestoName() {
    const nameInput = document.getElementById('restoName');
    const nameError = document.getElementById('restoNameError');
    const nameValue = nameInput.value;
    
    // Update counter
    updateNameCounter();
    
    // Check length (50 characters max)
    if (nameValue.length > 50) {
        nameError.textContent = 'Restaurant name must be 50 characters or less';
        nameError.style.display = 'block';
        return false;
    }
    
    // Allow all characters including special characters and numbers
    // No character restrictions, only length
    
    // Clear error if valid
    nameError.style.display = 'none';
    return true;
}

function validateRestoDesc() {
    const descInput = document.getElementById('restoDesc');
    const descError = document.getElementById('restoDescError');
    const descValue = descInput.value;
    
    // Update counter
    updateDescCounter();
    
    // Check length (150 characters max)
    if (descValue.length > 150) {
        descError.textContent = 'Description must be 150 characters or less';
        descError.style.display = 'block';
        return false;
    }
    
    // Allow all characters including special characters and numbers
    // No character restrictions, only length
    
    // Clear error if valid
    descError.style.display = 'none';
    return true;
}

function updateNameCounter() {
    const nameInput = document.getElementById('restoName');
    const counter = document.getElementById('nameCharCount');
    if (nameInput && counter) {
        const length = nameInput.value.length;
        counter.textContent = length;
        
        // Add warning color when near limit
        if (length > 40) { // > 80% of 50
            counter.style.color = 'orange';
            if (length === 50) {
                counter.style.color = 'red';
            }
        } else {
            counter.style.color = '';
        }
    }
}

function updateDescCounter() {
    const descInput = document.getElementById('restoDesc');
    const counter = document.getElementById('descCharCount');
    if (descInput && counter) {
        const length = descInput.value.length;
        counter.textContent = length;
        
        // Add warning color when near limit
        if (length > 120) { // > 80% of 150
            counter.style.color = 'orange';
            if (length === 150) {
                counter.style.color = 'red';
            }
        } else {
            counter.style.color = '';
        }
    }
}

// Initialize validation on page load
document.addEventListener('DOMContentLoaded', function() {
    // Set up event listeners for validation
    const nameInput = document.getElementById('restoName');
    const descInput = document.getElementById('restoDesc');
    
    if (nameInput) {
        nameInput.addEventListener('input', validateRestoName);
    }
    
    if (descInput) {
        descInput.addEventListener('input', validateRestoDesc);
    }
});

// Update form submission handler to include validation
document.getElementById('restaurant-form').addEventListener('submit', function(e) {
    e.preventDefault();
    
    // Validate inputs before submission
    const isNameValid = validateRestoName();
    const isDescValid = validateRestoDesc();
    
    if (!isNameValid || !isDescValid) {
        // Focus on first invalid field
        if (!isNameValid) {
            document.getElementById('restoName').focus();
        } else if (!isDescValid) {
            document.getElementById('restoDesc').focus();
        }
        return;
    }
    
    const formData = new FormData(this);
    const restoID = document.getElementById('restoID').value;
    const isEdit = restoID !== '';
    
    const url = isEdit ? `/admin/restaurants/${restoID}` : '/admin/restaurants';
    const method = isEdit ? 'PUT' : 'POST';
    
    const submitBtn = this.querySelector('.submit-btn');
    const originalText = submitBtn.innerHTML;
    submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Saving...';
    submitBtn.disabled = true;
    
    fetch(url, {
        method: method,
        body: formData
    })
    .then(response => response.json())
    .then(data => {
        if (data.message) {
            alert(data.message);
            closeModal();
            loadRestaurants(currentPage);
        }
    })
    .catch(error => {
        console.error('Error saving restaurant:', error);
        alert('Error saving restaurant. Please try again.');
    })
    .finally(() => {
        submitBtn.innerHTML = originalText;
        submitBtn.disabled = false;
    });
});

// Update the editRestaurant function to initialize counters
function editRestaurant(restoID) {
    fetch(`/admin/restaurants/${restoID}`)
        .then(response => response.json())
        .then(restaurant => {
            document.getElementById('modal-title').textContent = 'Edit Restaurant';
            document.getElementById('restoID').value = restaurant.restoID;
            document.getElementById('restoName').value = restaurant.restoName;
            document.getElementById('restoDesc').value = restaurant.restoDesc || '';
            document.getElementById('aveRating').value = restaurant.aveRating || 'M';
            
            // Initialize counters for existing values
            updateNameCounter();
            updateDescCounter();
            
            // Show current image if exists
            const imagePreview = document.getElementById('image-preview');
            imagePreview.innerHTML = '';
            if (restaurant.image) {
                const img = document.createElement('img');
                img.src = restaurant.image;
                img.alt = restaurant.restoName;
                imagePreview.appendChild(img);
            }
            
            document.getElementById('restaurant-modal').style.display = 'flex';
        })
        .catch(error => {
            console.error('Error loading restaurant:', error);
            alert('Error loading restaurant details. Please try again.');
        });
}

// Also update showAddRestaurantForm to initialize counters
function showAddRestaurantForm() {
    document.getElementById('modal-title').textContent = 'Add New Restaurant';
    document.getElementById('restaurant-form').reset();
    document.getElementById('restoID').value = '';
    document.getElementById('image-preview').innerHTML = '';
    
    // Initialize counters to 0
    document.getElementById('nameCharCount').textContent = '0';
    document.getElementById('descCharCount').textContent = '0';
    document.getElementById('nameCharCount').style.color = '';
    document.getElementById('descCharCount').style.color = '';
    
    document.getElementById('restaurant-modal').style.display = 'flex';
}

</script>
