<h1>Admin Dashboard</h1>

    
    <button class="add-resto-btn" onclick="showAddRestaurantForm()">
            <i class="fas fa-plus"></i> Add New 
        </button>

    <div id="restaurant-management" class="restaurant-management">
        <div class="table-container">
            <table class="restaurants-table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Name</th>
                        <th>Description</th>
                        <th>Rating</th>
                        <th>Image</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody id="restaurants-body">
                    
                </tbody>
            </table>
        </div>
        
        <div class="pagination" id="pagination">
            
        </div>
    </div>


<!-- Add/Edit Restaurant Modal -->
<div id="restaurant-modal" class="modal-overlay">
    <div class="modal-content">
        <h2 id="modal-title">Add New Restaurant</h2>
        <button class="modal-close" onclick="closeModal()">&times;</button>
        <div class="modal-body">
            <form id="restaurant-form" enctype="multipart/form-data">
                <input type="hidden" id="restoID" name="restoID">
                
                <div class="form-group">
                    <label for="restoName">Restaurant Name *</label>
                    <input type="text" id="restoName" name="restoName" required
                           placeholder="Enter restaurant name" maxlength="50"
                           oninput="validateRestoName()">
                    <span id="restoNameError" style="display: none; color: red; font-size: 12px; margin-top: 5px;"></span>
                    <div id="nameCounter" style="font-size: 12px; margin-top: 5px;">
                        Characters: <span id="nameCharCount">0</span>/50
                    </div>
                </div>
                
                <div class="form-group">
                    <label for="restoDesc">Description *</label>
                    <textarea id="restoDesc" name="restoDesc" rows="4" required
                              placeholder="Enter restaurant description" maxlength="150"
                              oninput="validateRestoDesc()"></textarea>
                    <span id="restoDescError" style="display: none; color: red; font-size: 12px; margin-top: 5px;"></span>
                    <div id="descCounter" style="font-size: 12px; margin-top: 5px;">
                        Characters: <span id="descCharCount">0</span>/150
                    </div>
                </div>
                
                <div class="form-group">
                    <label for="aveRating">Average Rating</label>
                    <select id="aveRating" name="aveRating">
                        <option value="M">Moderate (M)</option>
                        <option value="W">Worth it (W)</option>
                        <option value="L">Lacking (L)</option>
                    </select>
                </div>
                
                <div class="form-group">
                    <label for="image">Restaurant Image</label>
                    <input type="file" id="image" name="image" accept="image/*">
                    <small>Recommended size: 400x300px. Leave empty to keep current image when editing.</small>
                    <div id="image-preview" class="image-preview"></div>
                </div>
                
                <div class="form-actions">
                    <button type="button" class="cancel-btn" onclick="closeModal()">
                        <i class="fas fa-times"></i> Cancel
                    </button>
                    <button type="submit" class="submit-btn">
                        <i class="fas fa-save"></i> Save 
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div id="delete-modal" class="modal-overlay">
    <div class="modal-content">
            <h2>Confirm Delete</h2>
            <button class="modal-close" onclick="closeDeleteModal()">&times;</button>
        
            <div style="display: flex; flex-direction: column; ">
                <p style="font-size: 16px; line-height: 1.6; color: #2c3e50;">
                    Are you sure you want to delete this restaurant? 
                </p>
                
                <div class="form-actions">
                    <button type="button" class="cancel-btn" onclick="closeDeleteModal()">
                        <i class="fas fa-times"></i> Cancel
                    </button>
                    <button type="button" class="delete-confirm-btn" onclick="confirmDelete()">
                        <i class="fas fa-trash"></i> Confirm
                    </button>
                </div>
            </div>
        
    </div>
</div>
