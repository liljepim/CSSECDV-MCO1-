{{#each css}}
	<link rel="stylesheet" href="/css/{{this}}.css">
{{/each}}



<div class="container">
		{{#if success_msg}}
		<div class="flash-message flash-success">
			{{success_msg}}
		</div>
		{{/if}}
		
		{{#if error_msg}}
		<div class="flash-message flash-error">
			{{error_msg}}
		</div>
		{{/if}}
		
		{{#if info_msg}}
		<div class="flash-message flash-info">
			{{info_msg}}
		</div>
		{{/if}}
	

	<div class="account-panel">
		<div class="icon-container">
			<div class="main-icon" onclick="triggerFileInput()">
				<img class="profileimg" src="{{currentUser.userImage}}">
			</div>
			<div class="upload-icon">↑</div>
			<!-- Hidden input[type="file"] -->
			<input type="file" id="fileInput" name="fileInput" accept="image/*" name="image" form="editform">
		</div>
		<script>
			function triggerFileInput() {
				document.getElementById('fileInput').click();
			}
		</script>

		<div class="account-text-container">
			<h2 class="info-line1" style="text-align: center;">{{currentUser.userName}}</h2>
			<h2 class="info-line1" style="text-align: center;">ID: {{currentUser.userID}}</h2>
			<p style="text-align: center; margin-top: 5%; margin-bottom: 5%"><b>Review: {{currentUserReviewCount}}</b></p>
			<button class="donate-button">Donate</button>
			<form action="/logout">
				<input type="submit" class="logout-button" value="Logout"/>
			</form>
		</div>
	</div>
	<div class="review-panel">
		<form action="/editprofile/{{currentUser.userID}}" method="POST" id="editform" enctype="multipart/form-data">
			<h2 style="text-align: left; margin-top: 5%; margin-left: 5%">Account Details:</h2>
			<input type="text" name="userName" class="credentials" placeholder="{{currentUser.userName}}" value="{{currentUser.userName}}">
			<input type="password" name="userPassword" class="credentials" placeholder="New password (leave blank to keep current)">
			
			<h2 style="text-align: left; margin-top: 5%; margin-left: 5%">Description:</h2>
			<input type="text" name="userDesc" class="description" placeholder="{{currentUser.userDesc}}" value="{{currentUser.userDesc}}">
			
			<!-- Hidden field to store file input -->
			<input type="hidden" id="fileInputValue" name="fileInputValue">
			
			<button type="button" class="edit-button" onclick="showPasswordPopup()">Update</button>
		</form>
	</div>
</div>


<!-- Password Confirmation Popup -->
<div id="passwordPopup" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background-color: rgba(0, 0, 0, 0.5); z-index: 1000; justify-content: center; align-items: center;">
    <div style="background-color: white; width: 400px; max-width: 90%; border-radius: 15px; box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3); overflow: hidden; font-family: 'Segoe UI', Arial, sans-serif;">
        <div style="display: flex; flex-direction: column; padding: 30px;">
            
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 25px;">
                <h2 style="margin: 0; color: #333; font-size: 24px; font-weight: 600;">Confirm Changes</h2>
                <button type="button" style="background: none; border: none; font-size: 28px; cursor: pointer; color: #666; width: 36px; height: 36px; display: flex; align-items: center; justify-content: center; border-radius: 50%; transition: background-color 0.2s;" 
                        onmouseover="this.style.backgroundColor='#f0f0f0'" 
                        onmouseout="this.style.backgroundColor='transparent'"
                        onclick="closePasswordPopup()">&times;</button>
            </div>
            
            
            <p style="margin: 0 0 25px 0; color: #666; line-height: 1.5; font-size: 16px; text-align: left;">
                Please enter your current password to confirm the changes:
            </p>
            
            
            <input type="password" id="currentPassword" 
                   style="width: 100%; padding: 15px; border: 2px solid #e0e0e0; border-radius: 8px; font-size: 16px; box-sizing: border-box; margin-bottom: 20px; transition: border-color 0.3s;"
                   placeholder="Current password" 
                   required
                   onfocus="this.style.borderColor='#97EB02'"
                   onblur="this.style.borderColor='#e0e0e0'">
            

            <div id="popupError" style="color: #e74c3c; font-size: 14px; margin-bottom: 20px; padding: 12px 15px; background-color: #ffebee; border-radius: 8px; border-left: 4px solid #e74c3c; display: none; line-height: 1.4;"></div>
            
            
            <div style="display: flex; justify-content: flex-end; gap: 15px; margin-top: 10px;">
                <button type="button" 
                        style="padding: 12px 28px; border: 2px solid #ddd; border-radius: 8px; font-size: 16px; font-weight: 600; cursor: pointer; transition: all 0.3s ease; min-width: 100px; background-color: white; color: #333;"
                        onmouseover="this.style.backgroundColor='#f8f8f8'; this.style.borderColor='#ccc'"
                        onmouseout="this.style.backgroundColor='white'; this.style.borderColor='#ddd'"
                        onclick="closePasswordPopup()">Cancel</button>
                <button type="button" 
                        style="padding: 12px 28px; border: none; border-radius: 8px; font-size: 16px; font-weight: 600; cursor: pointer; transition: all 0.3s ease; min-width: 100px; background-color: #97EB02; color: #000;"
                        onmouseover="this.style.backgroundColor='#8adc02'; this.style.transform='translateY(-2px)'"
                        onmouseout="this.style.backgroundColor='#97EB02'; this.style.transform='translateY(0)'"
                        onclick="submitWithPassword()">Confirm</button>
            </div>
        </div>
    </div>
</div>

<script>
	// Handle file input change
	document.getElementById('fileInput').addEventListener('change', function(e) {
		if (e.target.files.length > 0) {
			// We'll handle this in the form submission
		}
	});

	// Show password popup
	function showPasswordPopup() {
		// Validate form before showing popup
		const userName = document.querySelector('input[name="userName"]').value.trim();
		const userDesc = document.querySelector('input[name="userDesc"]').value.trim();
		
		// Check if any changes were made
		const originalUserName = "{{currentUser.userName}}";
		const originalUserDesc = "{{currentUser.userDesc}}";
		
		if (userName === originalUserName && userDesc === originalUserDesc) {
			alert('No changes detected. Please make changes before updating.');
			return;
		}
		
		// Show the popup
		document.getElementById('passwordPopup').style.display = 'flex';
		document.getElementById('currentPassword').focus();
	}

	// Close password popup
	function closePasswordPopup() {
		document.getElementById('passwordPopup').style.display = 'none';
		document.getElementById('currentPassword').value = '';
		document.getElementById('popupError').style.display = 'none';
	}

	// Submit form with password verification
	function submitWithPassword() {
		const password = document.getElementById('currentPassword').value.trim();
		
		if (!password) {
			showPopupError('Please enter your current password');
			return;
		}
		
		// Create a hidden input for the current password
		const passwordInput = document.createElement('input');
		passwordInput.type = 'hidden';
		passwordInput.name = 'currentPassword';
		passwordInput.value = password;
		
		// Add it to the form
		document.getElementById('editform').appendChild(passwordInput);
		
		// Submit the form
		document.getElementById('editform').submit();
	}

	// Show error in popup
	function showPopupError(message) {
		const errorElement = document.getElementById('popupError');
		errorElement.textContent = message;
		errorElement.style.display = 'block';
	}

	// Close popup when clicking outside
	window.addEventListener('click', function(event) {
		const popup = document.getElementById('passwordPopup');
		if (event.target === popup) {
			closePasswordPopup();
		}
	});

	// Close popup with Escape key
	document.addEventListener('keydown', function(event) {
		if (event.key === 'Escape') {
			closePasswordPopup();
		}
	});
</script>

