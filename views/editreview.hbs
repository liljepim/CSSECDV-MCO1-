<div class="review-wrapper">
    <h1>Review a Resto</h1>
    <form id="reviewForm" action="/edit-review/{{review.reviewID}}" method="POST" onsubmit="return validateForm()">
        <input type="hidden" name="userID" value="{{review.userID}}">
        <input type="hidden" name="restoID" value="{{review.restoID}}">
        <input type="hidden" name="reviewID" value="{{review.reviewID}}">
        <input type="hidden" name="isEdited" value="true">

        <div class="review-form">
            <div class="rating-wrapper">
                <div class="resto-info">
                    <img src={{resto.image}}>
                    <div class="resto-details">
                        <h2>{{resto.restoName}}</h2>
                        <h3>Taft Avenue, Manila</h3>
                    </div>
                </div>

                <br>

                <div class="review-rating">
                    <label for="rating">Rating:</label>
                    <div class="rating-choices">
                        
                        <input type="radio" id="w" name="reviewRating" value="W">
                        <label for="w" class="radio-label">W</label>

                        
                        <input type="radio" id="mid" name="reviewRating" value="M">
                        <label for="mid" class="radio-label">MID</label>

                        
                        <input type="radio" id="l" name="reviewRating" value="L">
                        <label for="l" class="radio-label">L</label>
                    </div>
                    
                    <span id="ratingError" style="display: none;"></span>
                </div>

                <script>
                    if("{{review.reviewRating}}" == "W"){
                        document.getElementById('w').checked = true;
                    }
                    else if("{{review.reviewRating}}" == "M"){
                        document.getElementById('mid').checked = true;
                    }
                    else if("{{review.reviewRating}}" == "L"){
                        document.getElementById('l').checked = true;
                    }
                </script>

                <div class="review-buttons">
                    <button type="submit" id="submit-btn">Submit</button>
                </div>
            </div>

            <br>
            <div class="review-container">
                <div class="review-content-wrapper">
                    <label for="review">Review Title:</label>
                    <input type="text" id="reviewTitle" name="reviewTitle" value="{{review.reviewTitle}}" required maxlength="50" oninput="validateTitle()">
                    <span id="titleError" style="display: none;"></span>
                    <div id="titleCounter" style="font-size: 12px; margin-top: 5px;">
                        Characters: <span id="titleCharCount">{{review.reviewTitle.length}}</span>/50
                    </div>
                    <br>
                    <label for="review">Review:</label>
                    <textarea id="reviewContent" name="reviewContent" required class="review-textarea" maxlength="150" oninput="validateContent()">{{review.reviewContent}}</textarea>
                    <span id="contentError" style="display: none;"></span>
                    <div id="contentCounter" style="font-size: 12px; margin-top: 5px;">
                        Characters: <span id="contentCharCount">{{review.reviewContent.length}}</span>/150
                    </div>
                    <br>
                    <div class="file-upload">
                        <label for="media" class="custom-button">Upload Media:</label>
                        <input type="file" id="media" name="media" accept="image/*" multiple>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

<script>
    // Initialize when page loads
    document.addEventListener('DOMContentLoaded', function() {
        // Validate existing content on load
        validateTitle();
        validateContent();
        validateRating();
        
        // Add rating event listeners
        document.querySelectorAll('input[name="reviewRating"]').forEach(input => {
            input.addEventListener('change', validateRating);
        });
    });

    function updateCounter(elementId, counterId, maxLength) {
        const element = document.getElementById(elementId);
        const counter = document.getElementById(counterId);
        if (element && counter) {
            const length = element.value.length;
            counter.textContent = length;
            
            // Add warning color when near limit
            if (length > maxLength * 0.8) {
                counter.style.color = 'orange';
            } else {
                counter.style.color = '';
            }
        }
    }

    function validateTitle() {
        const titleInput = document.getElementById('reviewTitle');
        const titleError = document.getElementById('titleError');
        const titleValue = titleInput.value;
        
        // Update counter
        updateCounter('reviewTitle', 'titleCharCount', 50);
        
        // Check length
        if (titleValue.length > 50) {
            titleError.textContent = 'Title must be 50 characters or less';
            titleError.style.display = 'inline';
            titleError.style.color = 'red';
            titleError.style.marginLeft = '10px';
            titleError.style.fontSize = '12px';
            return false;
        }
        
        // Check for special characters (only allow letters, numbers, spaces)
        const specialCharRegex = /[^a-zA-Z0-9\s]/;
        if (specialCharRegex.test(titleValue)) {
            titleError.textContent = 'Title can only contain letters and numbers (no special characters)';
            titleError.style.display = 'inline';
            titleError.style.color = 'red';
            titleError.style.marginLeft = '10px';
            titleError.style.fontSize = '12px';
            return false;
        }
        
        // Clear error if valid
        titleError.style.display = 'none';
        return true;
    }

    function validateContent() {
        const contentInput = document.getElementById('reviewContent');
        const contentError = document.getElementById('contentError');
        const contentValue = contentInput.value;
        
        // Update counter
        updateCounter('reviewContent', 'contentCharCount', 150);
        
        // Check length
        if (contentValue.length > 150) {
            contentError.textContent = 'Review must be 150 characters or less';
            contentError.style.display = 'inline';
            contentError.style.color = 'red';
            contentError.style.marginLeft = '10px';
            contentError.style.fontSize = '12px';
            return false;
        }
        
        // Clear error if valid
        contentError.style.display = 'none';
        return true;
    }

    // ADDED: Rating validation function
    function validateRating() {
        const ratingInputs = document.querySelectorAll('input[name="reviewRating"]');
        const ratingError = document.getElementById('ratingError');
        
        let isChecked = false;
        ratingInputs.forEach(input => {
            if (input.checked) {
                isChecked = true;
            }
        });
        
        if (!isChecked) {
            ratingError.textContent = 'Please select a rating';
            ratingError.style.display = 'inline';
            ratingError.style.color = 'red';
            ratingError.style.marginLeft = '10px';
            ratingError.style.fontSize = '12px';
            return false;
        }
        
        ratingError.style.display = 'none';
        return true;
    }

    function validateForm() {
        const isTitleValid = validateTitle();
        const isContentValid = validateContent();
        const isRatingValid = validateRating(); // ADDED: Check rating
        
        if (!isTitleValid) {
            document.getElementById('reviewTitle').focus();
            return false;
        }
        
        if (!isContentValid) {
            document.getElementById('reviewContent').focus();
            return false;
        }
        
        if (!isRatingValid) { // ADDED: Check rating validation
            document.querySelector('input[name="reviewRating"]').focus();
            return false;
        }
        
        return true;
    }
</script>
