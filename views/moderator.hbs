<h1>Moderator Dashboard</h1>
{{#if success_msg}}
<div class="alert alert-success">
    {{success_msg}}
</div>
{{/if}}

{{#if error_msg}}
<div class="alert alert-danger">
    {{error_msg}}
</div>
{{/if}}

<style>
    .alert {
        padding: 12px 20px;
        border-radius: 4px;
        margin-bottom: 20px;
    }
    
    .alert-success {
        background-color: #d4edda;
        color: #155724;
        border: 1px solid #c3e6cb;
    }
    
    .alert-danger {
        background-color: #f8d7da;
        color: #721c24;
        border: 1px solid #f5c6cb;
    }
</style>

<div class="page-wrap">
  
    <div class="moderator-actions">
  
        
        {{#if reviews.length}}
        <div class="reviews-table-container">
            <table class="reviews-table">
                <thead>
                    <tr>
                        <th>Review Title</th>
                        <th>Review Content</th>
                        <th>Rating</th>
                        
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {{#each reviews}}
                    <tr>
                        <td>{{this.reviewTitle}}</td>
                        <td>{{this.reviewContent}}</td>
                        <td class="rating-cell">
                            {{#if (eq this.reviewRating 'W')}}
                                <span class="rating-badge rating-w">W</span>
                            {{else if (eq this.reviewRating 'L')}}
                                <span class="rating-badge rating-l">L</span>
                            {{else}}
                                <span class="rating-badge rating-m">M</span>
                            {{/if}}
                        </td>
                        
                        <td>
                            <form action="/moderator/delete-review/{{this.reviewID}}" method="POST" class="delete-form">
                                <button type="submit" class="delete-btn" onclick="return confirm('Are you sure you want to delete this review?')">
                                    Delete
                                </button>
                            </form>
                        </td>
                    </tr>
                    {{/each}}
                </tbody>
            </table>
        </div>
        {{else}}
        <p>No reviews found.</p>
        {{/if}}
    </div>
</div>

<style>
    .page-wrap {
        padding: 20px;
        max-width: 1200px;
        margin: 0 auto;
    }
    
    .moderator-actions {
        margin-top: 30px;
    }
    
    .reviews-table-container {
        overflow-x: auto;
        margin-top: 20px;
    }
    
    .reviews-table {
        width: 100%;
        border-collapse: collapse;
        background-color: white;
        box-shadow: 0 2px 5px rgba(0,0,0,0.1);
    }
    
    .reviews-table th {
        background-color: #f5f5f5;
        padding: 12px 15px;
        text-align: left;
        font-weight: 600;
        border-bottom: 2px solid #ddd;
    }
    
    .reviews-table td {
        padding: 12px 15px;
        border-bottom: 1px solid #eee;
        vertical-align: top;
    }
    
    .reviews-table tr:hover {
        background-color: #f9f9f9;
    }
    
    .rating-cell {
        width: 80px;
    }
    
    .rating-badge {
        display: inline-block;
        padding: 4px 10px;
        border-radius: 12px;
        font-weight: bold;
        font-size: 14px;
        color: white;
        text-align: center;
        min-width: 30px;
    }
    
    .rating-w {
        background-color: #4CAF50; /* Green for W (Worth It) */
    }
    
    .rating-l {
        background-color: #F44336; /* Red for L (Lacking) */
    }
    
    .rating-m {
        background-color: #FF9800; /* Orange for M (Moderate) */
    }
    
    .delete-form {
        margin: 0;
    }
    
    .delete-btn {
        background-color: #dc3545;
        color: white;
        border: none;
        padding: 6px 12px;
        border-radius: 4px;
        cursor: pointer;
        font-size: 14px;
        transition: background-color 0.2s;
    }
    
    .delete-btn:hover {
        background-color: #c82333;
    }
    
    h1 {
        color: #333;
        margin-bottom: 10px;
    }
    
    h2 {
        color: #555;
        margin-bottom: 20px;
    }
    
    p {
        color: #666;
        margin-bottom: 20px;
    }
</style>