<div class="page-wrap">
    <div class="logo big"></div>
    <div class="logo small"></div>
    <div class="change-wrap">
        <div class="register">
            <div class="change-form-wrap">
                <img class="text-logo" src="/img/tastetaft_text.svg" />
                <h1 class="bold">Change Password</h1>
                {{#if errorText}}
                <p style="color:red; text-align:center;">{{errorText}}</p>
                {{/if}}
                <form action="/change" method="POST" class="change-form">

                    <div id="pw-requirements" style="display:none;">
                        <p>Password must contain:</p>
                        <ul>
                            <li id="req-length" class="invalid">At least 8
                                characters</li>
                            <li id="req-upper" class="invalid">An uppercase
                                letter (A–Z)</li>
                            <li id="req-lower" class="invalid">A lowercase
                                letter (a–z)</li>
                            <li id="req-number" class="invalid">A number (0–9)</li>
                            <li id="req-special" class="invalid">A special
                                character (!@#$...)</li>
                        </ul>
                    </div>

                    <input
                        type="password"
                        class="input-box"
                        id="password"
                        placeholder="New Password"
                        name="password"
                        required
                    />
                    {{! <input
              type="text"
              class="input-box"
              id="id-number"
              placeholder="ID number"
              name="idnumber"
              
            /> }}

                    <div id="pw2-requirements" style="display:none; color:red;">
                        <h5>Password does not match</h5>
                    </div>
                    <input
                        type="password"
                        class="input-box"
                        id="password2"
                        placeholder="Confirm Password"
                        name="password2"
                        required
                    />

    

                    <button
                        type="submit"
                        class="form-button"
                        id="register-btn"
                        disabled
                    >Register</button>
                </form>
            </div>

        </div>
    </div>
</div>

<script src="/js/register-validation.js"></script>